---
title: "CRC paso a paso: emisor y receptor"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: entrada
    lg1: division
    lg2: resultado
  }
  class lg0 blue
  class lg1 yellow
  class lg2 teal
  state "Emisor" as s0 {
    s1: Entrada
    s2: Resultado: R(x) y la trama T(x)
    s3: División: un XOR por paso
    s4: Entrada, con el aviso de entrada inválida
  }
  state "Receptor" as s5 {
    s6: Entrada
    s7: Resultado: resto 0, sin error
    s8: División: un XOR por paso
    s9: Entrada, con el aviso de entrada inválida
    s10: Resultado: resto distinto de 0, hay error
  }
  [*] --> s1
  s1 --> s2: tocás #171;Siguiente#187; [entrada válida#59; la división no tiene ningún XOR]
